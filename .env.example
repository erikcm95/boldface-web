# Support form (Resend: https://resend.com). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. BoldFace Support <support@boldfaceaviation.com>
SUPPORT_FROM="BoldFace Support <support@boldfaceaviation.com>"
SUPPORT_TO=boldfaceaviation@gmail.com

# CloudKit JS (Apple ID sign-in + the user's private iCloud data).
# API token from CloudKit Console → iCloud.com.BoldFace.BoldFaceApp → Tokens & Keys. Safe to expose in the browser;
# it only works from the Allowed Origins set on the token.
NEXT_PUBLIC_CLOUDKIT_API_TOKEN=
NEXT_PUBLIC_CLOUDKIT_CONTAINER=iCloud.com.BoldFace.BoldFaceApp
NEXT_PUBLIC_CLOUDKIT_ENV=production
